# ==============================================================================
# Minimi Environment Configuration Template
# Copy this file to .env before running:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (MANDATORY)
# Minimi supports any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Ollama).
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# Optional: Custom OpenAI Base URL (e.g., for Groq or local Ollama)
# Groq:   https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier (e.g., gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile)
MINIMI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Search Provider Configuration (MANDATORY FOR LIVE SEARCH)
# Obtain a free key from https://tavily.com
# ------------------------------------------------------------------------------
TVLY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. Storage & Temporal Configuration (OPTIONAL - SENSIBLE DEFAULTS PROVIDED)
# ------------------------------------------------------------------------------
# Local SQLite database path
MINIMI_DB_PATH=./data/minimi.db

# IANA Timezone for local date parsing (e.g. "America/New_York", "Europe/London", "Asia/Kolkata")
# Defaults to system local timezone or UTC if unspecified.
MINIMI_TIMEZONE=UTC

# Application Port
PORT=3000
